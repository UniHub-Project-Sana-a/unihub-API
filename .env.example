# ===================================
# Application Settings
# ===================================
APP_NAME="اسم جامعتك"
APP_ENV=production
APP_KEY=base64:25w8ssfPqJZAWUgFddYHOupQCdttRGS0w9QMZNCt05E=
APP_DEBUG=false
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ===================================
# Logging
# ===================================
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ===================================
# Database Configuration
# ===================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=university_system
DB_USERNAME=db_user
DB_PASSWORD=secure_password

# ===================================
# Cache & Session
# ===================================
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===================================
# Queue & Broadcasting
# ===================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ===================================
# Redis (Optional - if not used, comment out)
# ===================================
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ===================================
# Email Configuration
# ===================================
# ⚠️ يجب تحديث هذه القيم ببيانات العميل
MAIL_MAILER=smtp
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===================================
# OAuth2 Passport
# ===================================
# ⚠️ سيتم إنشاؤها تلقائياً عند التثبيت
PASSPORT_CLIENT_ID=""
PASSPORT_CLIENT_SECRET=""

# ===================================
# AWS (Optional - if not used, leave empty)
# ===================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===================================
# Vite
# ===================================
VITE_APP_NAME="${APP_NAME}"