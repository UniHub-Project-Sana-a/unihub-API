### ---------------------------------------------------------------------
### 25) درجات الطلاب (student_grades) — المفتاح (assessment_id, student_id) — حذف فعلي
### ---------------------------------------------------------------------
POST {{baseUrl}}/api/external/v1/student_grades
Authorization: Bearer {{token}}
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "data": [
    {
      "academic_number": "2026001",
      "assessment": {
        "college_code": "fcit",
        "course_code": "CS101",
        "semester": {
          "level": { "program": { "department_code": "CS-DEP", "program_name": "fd", "academic_system": "semester", "block_based": true }, "level_number": 1 },
          "semester_name": "الفصل الأول",
          "academic_year": "2026",
          "term_number": 1
        },
        "name": "الاختبار النصفي",
        "max_score": 20
      },
      "score": 17.5,
      "notes": "أداء جيد"
    }
  ]
}

### ---------------------------------------------------------------------
### مثال حذف فعلي: إزالة طالب من مجموعة (student_group_members)
### ---------------------------------------------------------------------
DELETE {{baseUrl}}/api/external/v1/student_group_members
Authorization: Bearer {{token}}
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "data": [
    {
      "academic_number": "2026001",
      "college_code": "fcit",
      "department_code": "CS-DEP",
      "group_name": "المجموعة أ"
    }
  ]
}

### ---------------------------------------------------------------------
### 26) حالة خطأ متوقّعة — مورد غير معروف => 404
### ---------------------------------------------------------------------
POST {{baseUrl}}/api/external/v1/not_a_resource
Authorization: Bearer {{token}}
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "data": []
}
