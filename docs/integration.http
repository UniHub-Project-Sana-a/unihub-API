    }
  ]
}

### ---------------------------------------------------------------------
### 17) عناصر التقويم (course_assessments) — فصل إلزامي + مجموعة اختيارية + محاضر اختياري
### ---------------------------------------------------------------------
POST {{baseUrl}}/api/external/v1/course_assessments
Authorization: Bearer {{token}}
Content-Type: {{contentType}}
Accept: {{contentType}}

{
  "data": [
    {
      "college_code": "fcit",
      "course_code": "CS101",
      "semester": {
        "level": { "program": { "department_code": "CS-DEP", "program_name": "fd", "academic_system": "semester", "block_based": true }, "level_number": 1 },
        "semester_name": "الفصل الأول",
        "academic_year": "2026",
        "term_number": 1
      },
      "name": "الاختبار النصفي",
      "max_score": 20,
      "assessment_type": "midterm_exam",
      "week": 7,
      "weight": 20,
      "created_academic_number": "LEC001"
    }
  ]
}

